# Pi – samo LAN, bez HTTPS
# CRM:  http://IP/
# Mapa: http://IP:3847/  (i redirect sa /mapa)
:80 {
  encode gzip

  @api path /api /api/*
  handle @api {
    uri strip_prefix /api
    reverse_proxy backend:3001
  }

  # Preusmeri /mapa → port 3847 (zidni ekran)
  @mapa path /mapa /mapa/*
  handle @mapa {
    redir * http://{http.request.host}:3847/ 302
  }

  handle {
    reverse_proxy frontend:3000
  }
}
